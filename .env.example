# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# Never commit .env.local.

# Public: safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public: absolute URL of this app, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Required by the company research worker: a public https page where website
# owners can learn about LeadPilot's research bot and how to contact you. It is sent in the
# bot's User-Agent ("LeadPilotResearchBot/1.0 (+<this URL>)"). The worker refuses to fetch
# any website until this is set. Never prefix with NEXT_PUBLIC_.
RESEARCH_BOT_CONTACT_URL=

# SERVER ONLY. Shared secret that protects POST /api/research/worker. Create it yourself, at
# least 32 characters with NO spaces or other whitespace (visible ASCII only), and keep it out
# of source control. Generate one locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The worker answers "not configured" until a valid value is set. Never prefix with
# NEXT_PUBLIC_.
# See docs/SETUP.md, "Company research worker".
RESEARCH_WORKER_SECRET=
